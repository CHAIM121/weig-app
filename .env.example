# Public: exposed to browser code
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for Places API (New). Never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# Server-only test/local tooling (never expose to the browser)
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=

# Browser map key: enable Maps JavaScript API and restrict to your website origins.
# Keep this separate from the server-only Places key above.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only: coordinate-cache writes and aggregated Google metrics.
# Required for Phase 1 rollout; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Roll back search routing to the preserved legacy provider (no DB dependency).
PLACES_LEGACY_MODE=false
